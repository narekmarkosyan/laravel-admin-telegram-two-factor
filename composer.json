{
    "name": "narekmarkosyan/laravel-admin-telegram-two-factor",
    "description": "Add Telegram based two factor authentication to laravel-admin",
    "type": "library",
    "keywords": ["laravel-admin", "extension"],
    "homepage": "https://github.com/narekmarkosyan/laravel-admin-telegram-two-factor",
    "license": "MIT",
    "authors": [
        {
            "name": "Narek Markosyan",
            "email": "narek.markosyan@yahoo.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0",
        "encore/laravel-admin": "^1.9.2"
    },
    "require-dev": {
        "orchestra/testbench": "^9.13 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Narekmarkosyan\\LaravelAdminTelegramTwoFactor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/narekmarkosyan/laravel-admin"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Narekmarkosyan\\LaravelAdminTelegramTwoFactor\\AuthAttemptsServiceProvider"
            ]
        }
    }
}
